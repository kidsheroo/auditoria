# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Google Ads developer token (from Google Ads API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# Optional: MCC (manager account) customer ID — omit if using a direct account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Secret key for signing session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=change_me_to_a_random_secret

# Frontend URL for CORS + OAuth redirect
FRONTEND_URL=http://localhost:5173
